# 开发环境显式开启 Mock（仅公开变量，不含生产密钥）。
# 真实后端联调时改为 false，并配置 NEXT_PUBLIC_API_BASE_URL。
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE_URL=

# 本地 Node API（pnpm api:dev）。以下均为开发默认值，生产必须覆盖。
API_HOST=127.0.0.1
API_PORT=3032
APP_ORIGIN=http://localhost:3030
SESSION_SECRET=dev-only-session-secret-change-me
DEMO_ADMIN_PASSWORD=yyc3-demo-2026
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SESSION_MAX_LIFETIME_SECONDS=604800

# 登录限流（生产按风控要求调整；本地保持默认）
TRUST_PROXY=false
LOGIN_IP_LIMIT=60
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_IP_BLOCK_SECONDS=300
LOGIN_PHONE_LIMIT=5
LOGIN_PHONE_WINDOW_SECONDS=900
LOGIN_PHONE_BLOCK_SECONDS=900
