# 多店 SaaS 网关地址（本地真实 API 例如 http://localhost:3032/api）
NEXT_PUBLIC_API_BASE_URL=

# 仅本地无后端演示时设为 true；生产必须为 false，否则会使用 Mock 数据。
NEXT_PUBLIC_USE_MOCK=false

# 本地 Node API（pnpm api:dev）
API_HOST=127.0.0.1
API_PORT=3032
APP_ORIGIN=http://localhost:3030

# 生产必须使用独立强随机值，禁止使用示例值
SESSION_SECRET=
DEMO_ADMIN_PASSWORD=
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
# 会话绝对有效期（秒）；超过后刷新不再续期，必须重新登录
SESSION_MAX_LIFETIME_SECONDS=604800

# -----------------------------------------------------------------------------
# 登录限流（失败尝试计数入库，见 db/migrations/002_auth_rls.sql）
# 仅当 API 位于受信反向代理后时设置 TRUST_PROXY=true，
# 否则忽略 X-Forwarded-For，防止伪造来源绕过限流。
# -----------------------------------------------------------------------------
TRUST_PROXY=false
LOGIN_IP_LIMIT=60
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_IP_BLOCK_SECONDS=300
LOGIN_PHONE_LIMIT=5
LOGIN_PHONE_WINDOW_SECONDS=900
LOGIN_PHONE_BLOCK_SECONDS=900

# -----------------------------------------------------------------------------
# PostgreSQL（Phase 2 已接入，见 docs/.../10-PostgreSQL适用性分析.md）
# 拓扑：
#   主库（可写）：127.0.0.1:5433 或 192.168.3.22:5433
#   备库（只读）：100.65.172.88:5433
#   KB（独立）：192.168.3.45:5434 / yyc3_kb
#
# 角色：
#   owner：仅用于 pnpm db:migrate / db:seed
#   app：运行时连接，最小权限（非 superuser / 非 bypassrls）
#   密码不要写进本文件，放 .env.local（已 gitignore）
# -----------------------------------------------------------------------------
# 运行时（API）
DATABASE_URL=postgresql://yyc3_club_ops_app:${APP_PASSWORD}@127.0.0.1:5433/yyc3_club_ops
# 迁移/种子
DATABASE_OWNER_URL=postgresql://yyc3_club_ops_owner:${OWNER_PASSWORD}@127.0.0.1:5433/yyc3_club_ops

# 测试库（未配置时 PostgreSQL 集成测试自动跳过）
TEST_DATABASE_URL=postgresql://yyc3_club_ops_app:${APP_PASSWORD}@127.0.0.1:5433/yyc3_club_ops_test
TEST_DATABASE_OWNER_URL=postgresql://yyc3_club_ops_owner:${OWNER_PASSWORD}@127.0.0.1:5433/yyc3_club_ops_test

# 远端/生产库启用 TLS
DATABASE_SSL=false
